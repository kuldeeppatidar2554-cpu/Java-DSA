class Employee {

    private int id;
    private String name;
    private double salary;

    Employee(int id, String name, double salary) {

        this.id = id;
        this.name = name;
        this.salary = salary;
    }

    void display() {

        System.out.println("ID : " + id);
        System.out.println("Name : " + name);
        System.out.println("Salary : " + salary);
    }
}

public class OOPsInterviewPrograms {

    public static void main(String[] args) {

        Employee e = new Employee(101, "Kuldeep", 50000);

        e.display();
    }
}
