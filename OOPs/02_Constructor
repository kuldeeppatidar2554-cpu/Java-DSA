class Student {

    int id;
    String name;

    // Constructor
    Student(int id, String name) {
        this.id = id;
        this.name = name;
    }

    void display() {
        System.out.println(id + " " + name);
    }
}

public class Constructor {

    public static void main(String[] args) {

        Student s1 = new Student(101, "Kuldeep");
        Student s2 = new Student(102, "Rahul");

        s1.display();
        s2.display();
    }
}
