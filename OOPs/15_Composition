class Engine {

    void startEngine() {
        System.out.println("Engine Started");
    }
}

class Car {

    private Engine engine;

    Car() {
        engine = new Engine();
    }

    void startCar() {

        engine.startEngine();
        System.out.println("Car Started");
    }
}

public class Composition {

    public static void main(String[] args) {

        Car c = new Car();

        c.startCar();
    }
}
