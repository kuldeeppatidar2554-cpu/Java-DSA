public class BasicMathDSA {
    public static void main(String[] args) {

        int n = 153;
        int temp = n;

        // 1. Count Digits
        int count = 0;
        while (temp > 0) {
            count++;
            temp /= 10;
        }
        System.out.println("Count of Digits = " + count);

        // 2. Sum of Digits
        temp = n;
        int sum = 0;
        while (temp > 0) {
            sum += temp % 10;
            temp /= 10;
        }
        System.out.println("Sum of Digits = " + sum);

        // 3. Reverse Number
        temp = n;
        int rev = 0;
        while (temp > 0) {
            rev = rev * 10 + temp % 10;
            temp /= 10;
        }
        System.out.println("Reverse = " + rev);

        // 4. Palindrome Check
        if (n == rev)
            System.out.println("Palindrome Number");
        else
            System.out.println("Not Palindrome");

        // 5. Armstrong Check
        temp = n;
        int arm = 0;
        while (temp > 0) {
            int rem = temp % 10;
            arm += rem * rem * rem;
            temp /= 10;
        }

        if (arm == n)
            System.out.println("Armstrong Number");
        else
            System.out.println("Not Armstrong");

        // 6. Factorial
        int fact = 1;
        for (int i = 1; i <= 5; i++) {
            fact *= i;
        }
        System.out.println("Factorial of 5 = " + fact);

        // 7. Fibonacci Series
        System.out.print("Fibonacci : ");
        int a = 0, b = 1;
        for (int i = 1; i <= 10; i++) {
            System.out.print(a + " ");
            int c = a + b;
            a = b;
            b = c;
        }

        // 8. Prime Number
        int num = 17;
        boolean prime = true;

        for (int i = 2; i <= num / 2; i++) {
            if (num % i == 0) {
                prime = false;
                break;
            }
        }

        if (prime)
            System.out.println("\n17 is Prime");
        else
            System.out.println("\n17 is Not Prime");

        // 9. GCD (HCF)
        int x = 12, y = 18;
        int p = x, q = y;

        while (q != 0) {
            int r = p % q;
            p = q;
            q = r;
        }

        System.out.println("GCD = " + p);

        // 10. LCM
        int lcm = (x * y) / p;
        System.out.println("LCM = " + lcm);

        // 11. Even or Odd
        if (n % 2 == 0)
            System.out.println(n + " is Even");
        else
            System.out.println(n + " is Odd");

        // 12. Power
        int power = 1;
        for (int i = 1; i <= 3; i++) {
            power *= 2;
        }
        System.out.println("2^3 = " + power);
    }
}
