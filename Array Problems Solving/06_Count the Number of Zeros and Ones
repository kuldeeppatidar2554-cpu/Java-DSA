import java.util.Scanner;

public class CountZerosAndOnes {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input array size
        System.out.print("Enter size of array: ");
        int n = sc.nextInt();

        int[] arr = new int[n];

        int zeroCount = 0;
        int oneCount = 0;

        // Input array elements
        System.out.println("Enter array elements (0 or 1):");

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Count zeros and ones
        for (int i = 0; i < n; i++) {

            if (arr[i] == 0) {
                zeroCount++;
            } else if (arr[i] == 1) {
                oneCount++;
            }
        }

        // Display result
        System.out.println("Number of Zeros = " + zeroCount);
        System.out.println("Number of Ones = " + oneCount);

        sc.close();
    }
}
